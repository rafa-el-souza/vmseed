# Python and its tools
__pycache__/
*.py[cod]
*.egg-info/
/.venv/
/build/
/dist/
/.pytest_cache/
/.ruff_cache/
/.hypothesis/
/.coverage
/.coverage.*
/coverage.xml
/htmlcov/

# Fleet files name a host's directories and keys. Examples and tests keep
# their own.
vmseed.toml
!/examples/**/vmseed.toml
!/tests/**/vmseed.toml

# Cloud images, disks, seeds and UEFI variable stores
*.qcow2
*.img
*.raw
*.iso
*.fd

# Logs, state records, known_hosts files and directories of real VMs. Tests
# keep fixtures with these names.
*.log
vmseed.json
known_hosts
vms/
!/tests/**/*.log
!/tests/**/vmseed.json
!/tests/**/known_hosts
!/tests/**/vms/

# Host-check outputs describe the user's host: they stay on it.
/docs/host-checks/output/

# Keys
*.pem
*.key
id_rsa*
id_ecdsa*
id_ed25519*

# Local state of Claude Code
/.claude/settings.local.json
/.claude/worktrees/
