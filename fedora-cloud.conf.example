# fedora-cloud.sh configuration — simple KEY=VALUE, one per line.
# Copy to fedora-cloud.conf and edit. Pass with: fedora-cloud.sh --config fedora-cloud.conf <cmd>
#
# '#' comments and blank lines are ignored. Surrounding whitespace is trimmed.
# Unknown keys or malformed values are rejected. Any key you omit keeps the
# built-in default shown below. Paths are LITERAL: '~' is NOT expanded — use an
# absolute path if you override a *_DIR / *_FILE (the KEYS_DIR default is $HOME/.ssh).

# --- seed / paths ---
# TEMPLATE=./user-data.yaml            # cloud-config template
# TMUX_CONF=./dotfiles/tmux.conf       # tmux config injected into the std user's ~/.tmux.conf
# KEYS_DIR=~/.ssh                      # where the SSH keys live (default $HOME/.ssh)
# STD_USER=appuser                     # standard (no-sudo) username; valid Linux name
# ADMIN_USER=admin                     # admin (wheel, passwordless sudo) username
#                                      # must differ from each other, and must not be a
#                                      # reserved/system account (root, fedora, default, ...)
# STD_KEY_FILE=~/.ssh/appuser-fedora-cloud-01.pub  # defaults to KEYS_DIR/<STD_USER>-<DOMAIN>.pub
# ADM_KEY_FILE=~/.ssh/admin-fedora-cloud-01.pub    # defaults to KEYS_DIR/<ADMIN_USER>-<DOMAIN>.pub
# GENERATE_KEYS=yes                    # if a key file is absent: yes = create it;
#                                      # no = fail (you must provide the key yourself)
# ENCRYPT_KEYS=yes                     # auto-generated keys: yes = passphrase prompt
#                                      # (interactive); no = -N '' (non-interactive)
# BUILD_DIR=./build                    # generated seed + overlay
# IMAGES_DIR=./images                  # downloaded images + CHECKSUM + keyring
# INSTANCE_ID=fedora-01                # cloud-init instance-id  [A-Za-z0-9._-]
# VM_HOSTNAME=fedora-01                # guest hostname          [A-Za-z0-9._-]

# --- libvirt / boot ---
# DOMAIN=fedora-cloud-01               # libvirt domain name     [A-Za-z0-9._-]
# RAM_MB=2048                          # memory, positive integer
# VCPUS=2                              # vCPUs, positive integer
# LIBVIRT_URI=qemu:///session          # libvirt connection URI (unprivileged user session)
# NETWORK=user                         # virt-install --network. Options:
#                                      #   user            session-safe, no routable IP (default)
#                                      #   bridge=virbr0   session + bridge for a real IP (see README)
#                                      #   network=default only with a system URI: qemu:///system
# OSINFO=detect=on,require=off         # virt-install --osinfo value
# OVMF_CODE=/usr/share/edk2/ovmf/OVMF_CODE.fd  # explicit UEFI firmware (optional)

# --- download / verification ---
# VER=44                               # Fedora release, positive integer
# ARCH=x86_64                          # x86_64 | aarch64 | ppc64le | s390x
# FEDORA_GPG_URL=https://fedoraproject.org/fedora.gpg   # https:// only
# CHECKSUM_URL=                        # https:// full CHECKSUM url (skips discovery)
# COMPOSE=1.5                          # compose id (N or N.N); builds the CHECKSUM name
